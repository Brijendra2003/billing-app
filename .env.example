# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for the public share page (/share/<token>).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in WhatsApp/email links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Apps Script web app (see gas/Code.gs). Server only.
GAS_WEBAPP_URL=
GAS_SHARED_SECRET=
